# Copy to .env and fill in. .env is gitignored.

# PJM Data Miner 2 subscription key.
# Register at https://apiportal.pjm.com/ -> PJM Tools -> View Profile -> Your Subscriptions
# If left blank, etl/pjm_client.py falls back to the anonymous key that Data Miner 2's own
# web app publishes at https://dataminer2.pjm.com/config/settings.json (shared, 6 req/min).
PJM_KEY=

# Postgres (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5433
PGDATABASE=ftr
PGUSER=ftr
PGPASSWORD=ftr_local_dev

# Host port for the web app (container always listens on 8000 internally)
API_PORT=8080
